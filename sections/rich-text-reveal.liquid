{%- comment -%}
  ==========================================
  RICH TEXT REVEAL SECTION (v2.0 - Optimized)
  ==========================================
  
  A rich text section with scroll-triggered reveal animations.
  Optimized for high-DPI Retina displays.
  
  Features:
  - Heading with variable blur reveal (organic feel, GPU-friendly)
  - Body text with line-by-line blur fade reveal
  - Responsive layout with content indent on desktop
  - Animation toggle in theme customizer
  - Accessible with reduced motion support
  
  Performance Optimizations:
  - Lower blur values (3-6px instead of 10px)
  - Opacity-based animations instead of heavy filters
  - No character-level DOM manipulation for body
  - Uses transform for GPU acceleration
{%- endcomment -%}

{{ 'section-rich-text-reveal.css' | asset_url | stylesheet_tag }}

<section
  class="rich-text-reveal"
  data-section-id="{{ section.id }}"
  data-animation-enabled="{{ section.settings.enable_animation }}"
  aria-label="{{ section.settings.heading | strip_html | truncate: 50 }}"
>
  <div class="rich-text-reveal__wrapper">
    <div class="rich-text-reveal__container">
      <div class="rich-text-reveal__content">
        
        {%- comment -%} Heading with blur reveal animation {%- endcomment -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="rich-text-reveal__heading" data-heading>
            {{- section.settings.heading -}}
          </h2>
        {%- endif -%}

        {%- comment -%} Body wrapper with indent - Line-by-line reveal {%- endcomment -%}
        <div class="rich-text-reveal__body-wrapper">
          {%- if section.settings.body != blank -%}
            <div class="rich-text-reveal__body" data-body>
              {%- comment -%} Split body into lines for animation {%- endcomment -%}
              {%- assign body_sentences = section.settings.body | split: '. ' -%}
              {%- for sentence in body_sentences -%}
                <span class="rich-text-reveal__line" data-line="{{ forloop.index }}">
                  {{- sentence -}}{%- unless forloop.last -%}.{%- endunless -%}
                </span>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>

      </div>
    </div>
  </div>
</section>

{%- comment -%} Load GSAP and ScrollTrigger for animations {%- endcomment -%}
{%- if section.settings.enable_animation -%}
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/ScrollTrigger.min.js" defer></script>
  <script src="{{ 'section-rich-text-reveal.js' | asset_url }}" defer></script>
{%- endif -%}

{% schema %}
{
  "name": "Rich Text Reveal",
  "tag": "section",
  "class": "section-rich-text-reveal",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Established in India in 2018, Bassface was born from a passion for EDM culture"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body Text",
      "info": "Text will be split by periods (.) into separate lines for reveal animation.",
      "default": "Bassface was established in India in 2018 — born from a collective of EDM fans driven by pure love for the culture. What started as a shared passion for electronic music has grown into an independent creative entity, translating sound, energy, and emotion into wearable form."
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "checkbox",
      "id": "enable_animation",
      "label": "Enable text reveal animation",
      "default": true,
      "info": "Heading reveals with blur effect, body lines fade in with blur"
    }
  ],
  "presets": [
    {
      "name": "Rich Text Reveal",
      "category": "Text"
    }
  ]
}
{% endschema %}
