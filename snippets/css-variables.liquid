{% style %}
  {% comment %}
    ==========================================
    BASSFACE THEME 2026 - CSS DESIGN TOKENS
    ==========================================

    Design System Structure:
    1. Font Definitions & Loading
    2. Color Palette
    3. Typography Scale
    4. Spacing Scale
    5. Border Radius
    6. Breakpoints
    7. Semantic Tokens

    Typography Philosophy (MINAS-INSPIRED):
    - GT America LG Extended: Display/headings (Thin 100, Regular 400)
    - Aeonik Pro: Body/UI text (Regular 400, Medium 500)
    - Blacker Pro Text Book: Elegant accents (Light 300)
    - Smaller fonts with generous letter-spacing
    - Tighter line heights for refined look

    Color Philosophy:
    - Primary: Black - Main text and UI elements
    - Secondary: White - Backgrounds and inverse text
    - Accent: Orange - Highlights, active states, CTAs
    - Background: #EFEFEF (warm off-white like Minas)
  {% endcomment %}

  {% comment %}
    ==========================================
    FONT LOADING - Local Minas Fonts
    ==========================================
  {% endcomment %}

  {% comment %} GT America LG Extended - Display/Headings {% endcomment %}
  @font-face {
    font-family: 'GT America LG Extended';
    font-style: normal;
    font-weight: 100;
    font-display: swap;
    src: url('{{ "GT-America-LG-Extended-Thin.woff2" | asset_url }}') format('woff2');
  }

  @font-face {
    font-family: 'GT America LG Extended';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ "GT-America-LG-Extended-Regular.woff2" | asset_url }}') format('woff2');
  }

  {% comment %} Aeonik Pro - Body/UI Text {% endcomment %}
  @font-face {
    font-family: 'Aeonik Pro';
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url('{{ "AeonikPro-Regular.woff" | asset_url }}') format('woff');
  }

  @font-face {
    font-family: 'Aeonik Pro';
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url('{{ "AeonikPro-Medium.woff2" | asset_url }}') format('woff2');
  }

  {% comment %} Blacker Pro Text Book - Elegant Accents {% endcomment %}
  @font-face {
    font-family: 'Blacker Pro Text Book';
    font-style: normal;
    font-weight: 300;
    font-display: swap;
    src: url('{{ "Blacker-Pro-Text-Book.woff2" | asset_url }}') format('woff2');
  }

  {% comment %} Shopify Font Settings (kept for compatibility) {% endcomment %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    {% comment %}
      ==========================================
      1. FONT FAMILIES
      ==========================================
    {% endcomment %}

    {% comment %} Base Fonts - Minas Inspired {% endcomment %}
    --font-display: 'GT America LG Extended', sans-serif;  /* Display/headings - Thin 100, Regular 400 */
    --font-body: 'Aeonik Pro', sans-serif;                 /* Primary functional font - Regular 400, Medium 500 */
    --font-accent: 'Blacker Pro Text Book', serif;         /* Elegant accents - Light 300 */
    --font-heading: 'GT America LG Extended', sans-serif;  /* Headings */

    {% comment %} Shopify Font Settings Integration {% endcomment %}
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};

    {% comment %}
      ==========================================
      2. FONT WEIGHTS
      ==========================================
      Minas font weights:
      - GT America: 100 (Thin), 400 (Regular)
      - Aeonik Pro: 400 (Regular), 500 (Medium)
      - Blacker Pro: 300 (Book/Light)
    {% endcomment %}
    --font-weight-thin: 100;      /* GT America Thin */
    --font-weight-light: 300;     /* Blacker Pro Book */
    --font-weight-normal: 400;    /* Aeonik Pro Regular, GT America Regular */
    --font-weight-medium: 500;    /* Aeonik Pro Medium */

    {% comment %}
      ==========================================
      3. COLOR PALETTE
      ==========================================
      Primary: Black
      Secondary: White
      Accent: Orange
    {% endcomment %}

    {% comment %} Core Brand Colors {% endcomment %}
    --color-primary: #000000;                     /* Black - Main brand color */
    --color-secondary: #FFFFFF;                   /* White - Secondary brand color */
    --color-accent: #FE7F2D;                      /* Orange - Accent/highlight color */
    --color-accent-rgb: 254, 127, 45;             /* RGB for opacity variants */

    {% comment %} Background Colors {% endcomment %}
    --color-background: {{ settings.background_color | default: '#EFEFEF' }};  /* Minas warm off-white */
    --color-background-primary: #FFFFFF;          /* Pure white for cards/sections */
    --color-background-secondary: #EFEFEF;        /* Warm off-white (Minas default) */
    --color-background-tertiary: #000000;         /* Black background (for inverse sections) */

    {% comment %} Text Colors {% endcomment %}
    --color-foreground: {{ settings.foreground_color | default: '#000000' }};
    --color-text-primary: #000000;                /* Black - Primary text */
    --color-text-secondary: #787878;              /* Medium gray - Secondary text */
    --color-text-tertiary: rgba(120, 120, 120, 0.53);  /* Light gray with opacity */
    --color-text-inverse: #FFFFFF;                /* White text on dark backgrounds */
    --color-text-accent: #FE7F2D;                 /* Orange text for highlights */

    {% comment %} Border Colors {% endcomment %}
    --color-border-primary: #000000;              /* Black borders */
    --color-border-secondary: rgba(0, 0, 0, 0.1); /* Light borders */
    --color-border-accent: #FE7F2D;               /* Accent borders */

    {% comment %} State Colors {% endcomment %}
    --color-hover: var(--color-accent);           /* Orange hover state */
    --color-active: var(--color-accent);          /* Orange active state */
    --color-focus: var(--color-accent);           /* Orange focus state */
    --color-disabled: #CCCCCC;                    /* Disabled state */

    {% comment %}
      ==========================================
      4. TYPOGRAPHY SCALE
      ==========================================
      Desktop-first sizing (1440px base) with mobile overrides
    {% endcomment %}

    {% comment %} Font Sizes - Minas Inspired (smaller, tighter) {% endcomment %}
    --font-size-2xs: 0.625rem;    /* 10px - Small labels, nav items */
    --font-size-xs: 0.6875rem;    /* 11px - Cart count, buttons */
    --font-size-sm: 0.8125rem;    /* 13px - Labels, captions */
    --font-size-base: 0.875rem;   /* 14px - Body text (was 16px) */
    --font-size-md: 0.9375rem;    /* 15px - Subheadings */
    --font-size-lg: 1.125rem;     /* 18px - Section headings */
    --font-size-xl: 1.5625rem;    /* 25px - Feature headings */
    --font-size-2xl: 2.5rem;      /* 40px - Large headings */
    --font-size-3xl: 3.75rem;     /* 60px - Display headings */

    {% comment %} Line Heights - Tighter like Minas {% endcomment %}
    --line-height-tight: 1.1;      /* Headings */
    --line-height-normal: 1.35;    /* Body text (was 1.5) */
    --line-height-relaxed: 1.5;    /* Large text (was 1.75) */

    {% comment %} Letter Spacing - More generous like Minas {% endcomment %}
    --letter-spacing-tight: -0.01em;
    --letter-spacing-normal: 0;
    --letter-spacing-wide: 0.08em;     /* Labels, nav */
    --letter-spacing-wider: 0.15em;    /* Large headings */

    {% comment %}
      ==========================================
      5. SPACING SCALE
      ==========================================
      Consistent spacing rhythm
    {% endcomment %}
    --space-1: 0.25rem;   /* 4px */
    --space-2: 0.3125rem; /* 5px */
    --space-3: 0.5rem;    /* 8px */
    --space-4: 0.625rem;  /* 10px */
    --space-5: 1rem;      /* 16px */
    --space-6: 1.125rem;  /* 18px */
    --space-7: 1.25rem;   /* 20px */
    --space-8: 1.5625rem; /* 25px */
    --space-9: 1.875rem;  /* 30px */
    --space-10: 2.5rem;   /* 40px */
    --space-11: 3rem;     /* 48px */
    --space-12: 3.5rem;   /* 56px */
    --space-13: 3.75rem;  /* 60px */
    --space-14: 3.875rem; /* 62px */

    {% comment %} Semantic Spacing Names {% endcomment %}
    --gap-micro: var(--space-1);      /* 4px */
    --gap-tiny: var(--space-2);       /* 5px */
    --gap-xs: var(--space-3);         /* 8px */
    --gap-sm: var(--space-4);         /* 10px */
    --gap-md: var(--space-5);         /* 16px */
    --gap-lg: var(--space-9);         /* 30px */
    --gap-xl: var(--space-10);        /* 40px */

    {% comment %}
      ==========================================
      6. BORDER RADIUS
      ==========================================
    {% endcomment %}
    --radius-sm: 0.3125rem;   /* 5px - Cards, images */
    --radius-md: 0.625rem;    /* 10px - Search bar modal */
    --radius-lg: 1rem;        /* 16px - Large components */
    --radius-full: 9999px;    /* Fully rounded */

    {% comment %} Shopify Settings Integration {% endcomment %}
    --style-border-radius-inputs: {{ settings.input_corner_radius | default: 5 }}px;

    {% comment %}
      ==========================================
      7. BREAKPOINTS - DESKTOP-FIRST
      ==========================================
      Base styles for 1440px, scale DOWN with max-width queries
      Breakpoint Flow: 1440px → 1024px → 700px → 412px
    {% endcomment %}
    --breakpoint-sm: 412px;   /* Small mobile */
    --breakpoint-md: 700px;   /* Mobile - Font swap threshold */
    --breakpoint-lg: 1024px;  /* Tablet */
    --breakpoint-xl: 1440px;  /* Desktop (base) */
    --breakpoint-2xl: 1920px; /* Large desktop */

    {% comment %}
      ==========================================
      8. LAYOUT
      ==========================================
    {% endcomment %}
    --page-width: {{ settings.max_page_width | default: 1440 }};
    --page-margin: {{ settings.min_page_margin | default: 20 }}px;
    --header-height: 4rem;        /* 64px - Desktop header */
    --header-height-mobile: 3.5rem; /* 56px - Mobile header */

    {% comment %}
      ==========================================
      9. SEMANTIC TYPOGRAPHY TOKENS
      ==========================================
      Purpose-based token names for consistent usage
    {% endcomment %}

    {% comment %} Headings - GT America (Thin 100 for large, Regular 400 for small) {% endcomment %}
    --heading-h1-size: var(--font-size-3xl);  /* 60px */
    --heading-h1-weight: var(--font-weight-thin);  /* 100 */
    --heading-h1-line-height: 1;                   /* Tight for large display */
    --heading-h1-letter-spacing: 0.03em;

    --heading-h2-size: var(--font-size-2xl);  /* 40px */
    --heading-h2-weight: var(--font-weight-normal);  /* 400 */
    --heading-h2-line-height: var(--line-height-tight);
    --heading-h2-letter-spacing: 0.02em;

    --heading-h3-size: var(--font-size-xl);    /* 25px */
    --heading-h3-weight: var(--font-weight-normal);  /* 400 */
    --heading-h3-line-height: var(--line-height-tight);

    --heading-h4-size: var(--font-size-lg);    /* 18px */
    --heading-h4-weight: var(--font-weight-normal);  /* 400 */
    --heading-h4-line-height: var(--line-height-normal);

    {% comment %} Body Text - Aeonik Pro {% endcomment %}
    --body-size: var(--font-size-base);       /* 14px */
    --body-weight: var(--font-weight-normal);  /* 400 */
    --body-line-height: var(--line-height-normal);

    --body-sm-size: var(--font-size-sm);       /* 13px */
    --body-sm-weight: var(--font-weight-normal);  /* 400 */
    --body-sm-line-height: var(--line-height-normal);

    {% comment %} Display Text - GT America Thin {% endcomment %}
    --display-sm-size: var(--font-size-lg);    /* 18px */
    --display-md-size: var(--font-size-xl);    /* 25px */
    --display-lg-size: var(--font-size-3xl);   /* 60px */

    {% comment %} UI Elements {% endcomment %}
    --label-size: var(--font-size-xs);         /* 11px */
    --label-weight: var(--font-weight-normal); /* 400 */
    --label-letter-spacing: normal;            /* Normal spacing like Minas header */

    --button-size: var(--font-size-base);      /* 14px */
    --button-weight: var(--font-weight-normal);  /* 400 */
    --button-letter-spacing: 0.05em;

    {% comment %}
      ==========================================
      10. TRANSITIONS & ANIMATIONS
      ==========================================
    {% endcomment %}
    --transition-fast: 150ms ease-in-out;
    --transition-base: 250ms ease-in-out;
    --transition-slow: 400ms ease-in-out;

    --ease-in-out: cubic-bezier(0.4, 0, 0.2, 1);
    --ease-out: cubic-bezier(0, 0, 0.2, 1);
    --ease-in: cubic-bezier(0.4, 0, 1, 1);

    {% comment %}
      ==========================================
      11. Z-INDEX SCALE
      ==========================================
      Consistent layering system
    {% endcomment %}
    --z-index-base: 1;
    --z-index-dropdown: 100;
    --z-index-sticky: 200;
    --z-index-fixed: 300;
    --z-index-modal-backdrop: 400;
    --z-index-modal: 500;
    --z-index-popover: 600;
    --z-index-tooltip: 700;

    {% comment %}
      ==========================================
      12. SHADOWS
      ==========================================
    {% endcomment %}
    --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    --shadow-base: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px -1px rgba(0, 0, 0, 0.1);
    --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
    --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -4px rgba(0, 0, 0, 0.1);
    --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
  }

  {% comment %}
    ==========================================
    RESPONSIVE TYPOGRAPHY - DESKTOP-FIRST
    ==========================================
    Desktop (base): Larger display sizes with GT America Thin
    Mobile (≤700px): Slightly smaller, same fonts
  {% endcomment %}
  :root {
    {% comment %} Desktop base sizes (1440px) {% endcomment %}
    --font-size-3xl: 3.75rem;  /* 60px on desktop */
    --heading-h1-size: 3.75rem;  /* 60px on desktop */
  }

  @media (max-width: 700px) {
    :root {
      {% comment %} Scale down font sizes for mobile {% endcomment %}
      --font-size-3xl: 2.5rem;    /* 40px on mobile */
      --heading-h1-size: 2.5rem;  /* 40px on mobile */
      --font-size-base: 0.8125rem;  /* 13px on mobile */
    }
  }

  {% comment %}
    ==========================================
    UTILITY CLASSES - Display Text (Desktop-First)
    ==========================================
    Desktop & Mobile: GT America with generous letter-spacing
  {% endcomment %}

  {% comment %} Display text - GT America Thin for large, Regular for small {% endcomment %}
  .display-text {
    font-family: var(--font-display);
    font-weight: var(--font-weight-thin);  /* 100 for elegant look */
    letter-spacing: var(--letter-spacing-wider);
    line-height: 1.1;
  }

  .display-sm {
    font-family: var(--font-display);
    font-size: var(--display-sm-size);
    font-weight: var(--font-weight-normal);  /* 400 for smaller display */
    letter-spacing: 0.05em;
  }

  .display-md {
    font-family: var(--font-display);
    font-size: var(--display-md-size);
    font-weight: var(--font-weight-thin);
    letter-spacing: 0.03em;
  }

  .display-lg {
    font-family: var(--font-display);
    font-size: var(--display-lg-size);
    font-weight: var(--font-weight-thin);
    letter-spacing: var(--letter-spacing-wider);
  }

  {% comment %} Body text - Aeonik Pro {% endcomment %}
  .text-body {
    font-family: var(--font-body);
    font-weight: var(--font-weight-normal);
  }

  {% comment %} Heading text - GT America {% endcomment %}
  .text-heading {
    font-family: var(--font-heading);
    font-weight: var(--font-weight-thin);
  }

  {% comment %} Accent/elegant text - Blacker Pro {% endcomment %}
  .text-accent {
    font-family: var(--font-accent);
    font-weight: var(--font-weight-light);  /* 300 */
  }

  {% comment %} Labels and nav - GT America Regular {% endcomment %}
  .text-label {
    font-family: var(--font-display);
    font-size: var(--label-size);
    font-weight: var(--font-weight-normal);
    text-transform: uppercase;
  }
{% endstyle %}
